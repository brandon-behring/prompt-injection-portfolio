# Python
__pycache__/
*.py[oc]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# Tooling clones — research_toolkit validators pinned at a release tag for
# `make dossier-audit` (ADR-051). Bootstrapped on demand; never committed.
/.tooling/

# Portfolio eval artifacts (large; runtime outputs)
evals/predictions/
evals/predictions_val/
evals/checkpoints/
evals/lane*/predictions/
# runpod-deploy per-run telemetry + log pulls (scripts/runpod_sweep.py)
artifacts/runpod/

# Data — gitignored by default; manifests + processed parquets per plan §3
data/raw/
data/processed/
.hf_cache/

# Secrets — never commit (repo is public from M0 per ADR-024)
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.cert
secrets/
.secrets/

# Transcripts: private by default per submission convention; README inside stays tracked
transcripts/*.md
!transcripts/README.md
transcripts/auto/

# Book scaffold outputs (Astro build artifacts)
book/dist/
book/dist-pdf/
book/.astro/
book/node_modules/
book/.pagefind/

# Dossier inbox (raw landing for compass artifacts before decomposition)
docs/research/_inbox/

# Dossier PDF cache (Sprint 2 E2 --cache-pdfs output; ~250 MB across 5 topics)
# Re-fetchable via cache_manifest.yml + cache/bib_primary_source_cache.yml metadata
# Public-repo licensing posture per Sprint 2 plan: vendor blogs + closed-access papers
# cannot be re-hosted publicly even if arXiv mirroring is technically permitted
docs/research/*/papers/

# Cost ledger remains tracked; per-run logs may be gitignored later
# evals/cost_ledger.csv — tracked

# Smoke-time fixture outputs (per submission's pattern; M0 Day 3+)
tests/fixtures/predictions/
tests/fixtures/checkpoints/
tests/fixtures/metrics/

# Local scratch space (issue bodies, ad-hoc drafts; not for the repo)
.scratch/

# Attack-type-LODO harness runtime outputs (large: per-(seed,fold,rung) predictions
# parquet + metrics.json + MANIFEST; a full sweep is hundreds of MB and is fully
# regenerated by harness.py — curated results live in the lane results.md, the
# write-gate verdict in experiments/eda/OOD_WALL_PREDICTION/).
experiments/attack-type-lodo/results/**
# …EXCEPT the 9 off-the-shelf reference-probe metrics (3 probes × 3 folds, seed=0): the
# ADR-054 reference column (incl. PG1 core-fold AUPRC 0.998) cites them — provenance W9.
!experiments/attack-type-lodo/results/seed=0/
!experiments/attack-type-lodo/results/seed=0/*/
!experiments/attack-type-lodo/results/seed=0/*/reference_*.metrics.json
# rehearsal / scratch sweep dirs (e.g. results_dressrehearsal_*)
experiments/attack-type-lodo/results_*/
# C1 treated-arm predictions tree (~7 MB parquets carrying BIPIA text; regenerated
# deterministically by run_c1.py from the COMMITTED corpus_gated.parquet). The per-seed
# metrics.json (val_roc_auc the verdict reads) + MANIFEST.json ARE committed.
experiments/carrier-table-training/C1_results_treated/**
!experiments/carrier-table-training/C1_results_treated/MANIFEST.json
!experiments/carrier-table-training/C1_results_treated/seed=*/
!experiments/carrier-table-training/C1_results_treated/seed=*/*/
!experiments/carrier-table-training/C1_results_treated/seed=*/*/*.metrics.json

# Cross-family-transfer B2.3 harness outputs (large per-fold predictions parquet, ~650 MB;
# regenerated by run_b2_3.py). The curated summary.json + B2_3_FINDINGS.md ARE committed.
experiments/cross-family-transfer/B2_3_results/**/*.parquet
experiments/cross-family-transfer/B2_3_results/**/*.metrics.json
# B2.4 Arm-A (run_b2_4.py) + Arm-B B+ (run_b2_3.py --variant B+) outputs — same discipline:
# large per-fold parquet + metrics.json gitignored (Bplus ~648 MB), curated summary.json committed.
experiments/cross-family-transfer/B2_3_results_Bplus/**/*.parquet
experiments/cross-family-transfer/B2_3_results_Bplus/**/*.metrics.json
experiments/cross-family-transfer/B2_4_results/**/*.parquet
experiments/cross-family-transfer/B2_4_results/**/*.metrics.json
# B3 cheap-GPU LoRA RunPod outputs (all27 + bplus_cheap) — large per-fold predictions
# parquet gitignored; the metrics.json ARE committed (unlike B2.3/B2.4 above).
experiments/cross-family-transfer/B3_results_runpod_*_lora/**/*.parquet
experiments/cross-family-transfer/**/*.log

# dataset-auditor per-dataset scratch JSON (fan-out --out outputs; regenerated)
experiments/eda/_survey/

# Reproduction audit scratch logs (the *.json results + scripts + README ARE committed)
experiments/REPRODUCTION_2026-06/*.log

# Claude Code session lock (runtime artifact)
.claude/scheduled_tasks.lock
